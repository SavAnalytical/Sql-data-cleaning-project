# from above we can vividly see that Airbnb has an industry in some record. we can simply populate other blank space to travel industry
-- using join(reason becos we gonna use those with travel to update the other..self join 

select*
from layoffs_staging2 as t1
join layoffs_staging2 as t2
on t1.company = t2.company #possible to have Airbnb in a different location will blank space
where(t1.industry is null or t1.industry = '')
and t2.industry is not null;

select t1.industry, t2.industry
from layoffs_staging2 as t1
join layoffs_staging2 as t2
on t1.company = t2.company #possible to have Airbnb in a different location, will blank space
where(t1.industry is null or t1.industry = '')
and t2.industry is not null;

#set t1 to be nul
update layoffs_staging2
set industry = null
where industry = '';

#basically t2 will be used to populate t1
update layoffs_staging2 as t1
join layoffs_staging2 as t2
	on t1.company = t2.company
set t1.industry= t2.industry
where t1.industry is null
and t2.industry is not null;

