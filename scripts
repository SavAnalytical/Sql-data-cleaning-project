# identifying duplicate
select*,
ROW_NUMBER() over(
partition by company, location, industry, total_laid_off, percentage_laid_off, 'date', stage, country, funds_raised_millions) as row_num
from layoffs_staging;

# above we assign a unique identifier, which is 1 for each record. 
# so we use CTE to check if any record is greater than 1 or is a duplicate

with duplicate_cte AS
(
select*,
ROW_NUMBER() over(
partition by company, location, industry, total_laid_off, percentage_laid_off, 'date', stage, country, funds_raised_millions) as row_num
from layoffs_staging
)
select*
from duplicate_cte
WHERE row_num > 1;

#confirmation if they are actually duplicates by treating  each duplicate independently, allowing us to verify each record
select*
from layoffs_staging
where company = 'zymergen'
;

# We create a table, layoffs_staging2, and insert the column. This table allows us to delete duplicates
CREATE TABLE `layoffs_staging2` (
  `company` text,
  `location` text,
  `industry` text,
  `total_laid_off` int DEFAULT NULL,
  `percentage_laid_off` text,
  `date` text,
  `stage` text,
  `country` text,
  `funds_raised_millions` int DEFAULT NULL,
  `row_num` INT
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

select*
from layoffs_staging2;

#we inserted the unique identifier records into layoffs....2
insert into layoffs_staging2
select*,
ROW_NUMBER() over(
partition by company, location, industry, total_laid_off, percentage_laid_off, 'date', stage, country, funds_raised_millions) as row_num
from layoffs_staging;


select*
from layoffs_staging2
where row_num > 1; # this are the duplicate

# we can delete  using

delete
from layoffs_staging2
where row_num > 1;# must be rows greater than 1

